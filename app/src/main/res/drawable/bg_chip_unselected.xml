<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_pressed" />
            <stroke android:width="1.5dp" android:color="@color/border_strong" />
            <corners android:radius="14dp" />
            <padding
                android:left="12dp"
                android:top="5dp"
                android:right="12dp"
                android:bottom="5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <stroke android:width="1.2dp" android:color="@color/border_card" />
            <corners android:radius="14dp" />
            <padding
                android:left="12dp"
                android:top="5dp"
                android:right="12dp"
                android:bottom="5dp" />
        </shape>
    </item>
</selector>
