<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="笔记标题"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/etDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_edit_text"
        android:hint="@string/note_title_hint"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:singleLine="true"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="所属文件夹 / 目录"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/etDialogFolder"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_edit_text"
        android:hint="@string/note_folder_hint"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:singleLine="true"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="标签 (多个标签用逗号隔开)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/etDialogTags"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_edit_text"
        android:hint="@string/note_tags_hint"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:singleLine="true"
        android:layout_marginTop="4dp" />
</LinearLayout>
