<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- 顶栏：返回、标题、翻页与核心页面动作（精简去重，确保 320dpi 竖屏下标题完整可见） -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@color/bg_surface">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_arrow_back"
            android:padding="7dp"
            android:contentDescription="返回"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/tvNoteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="80dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:text="未命名笔记"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 翻页胶囊：点页码切换底部胶片抽屉，长按打开全屏网格概览 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_button_secondary"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="5dp">

            <ImageButton
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:id="@+id/btnPrevPage"
                android:layout_width="28dp"
                android:layout_height="30dp"
                android:background="@null"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="上一页" />

            <TextView
                android:id="@+id/tvPageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="40dp"
                android:text="1 / 1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="3dp" />

            <ImageButton
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:id="@+id/btnNextPage"
                android:layout_width="28dp"
                android:layout_height="30dp"
                android:background="@null"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="下一页" />
        </LinearLayout>

        <ImageButton
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:id="@+id/btnAddPage"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_button_secondary"
            android:src="@drawable/ic_add_page"
            android:contentDescription="在当前页后插入新页"
            android:layout_marginEnd="5dp" />

        <ImageButton
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:id="@+id/btnPages"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_button_secondary"
            android:src="@drawable/ic_pages"
            android:contentDescription="页面概览与大纲"
            android:layout_marginEnd="5dp" />

        <ImageButton
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:id="@+id/btnSplitObsidian"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_button_secondary"
            android:src="@drawable/ic_split"
            android:contentDescription="Obsidian 双栏同屏对照"
            android:layout_marginEnd="5dp" />

        <ImageButton
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:id="@+id/btnRecognize"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_button_secondary"
            android:src="@drawable/ic_recognize"
            android:contentDescription="识别手写"
            android:layout_marginEnd="5dp" />

        <ImageButton
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:id="@+id/btnRefresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_button_secondary"
            android:src="@drawable/ic_refresh_full"
            android:contentDescription="全刷清残影"
            android:layout_marginEnd="5dp" />

        <ImageButton
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:id="@+id/btnZen"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_button_secondary"
            android:src="@drawable/ic_fullscreen"
            android:contentDescription="全屏沉浸模式"
            android:layout_marginEnd="5dp"
            android:visibility="gone" />

        <ImageButton
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:id="@+id/btnDockPosition"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_button_secondary"
            android:src="@drawable/ic_dock"
            android:contentDescription="工具栏停靠位置"
            android:layout_marginEnd="5dp"
            android:visibility="gone" />

        <ImageButton
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:id="@+id/btnMore"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_button_secondary"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="更多与快捷命令" />
    </LinearLayout>

    <View
        android:id="@+id/dividerTop"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="@color/border_hairline" />

    <!-- 编辑器主体：包含左侧停靠、中央画布区域、Obsidian 同屏分栏与右侧停靠 -->
    <LinearLayout
        android:id="@+id/layoutEditorBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧垂直避手停靠栏 (Dock LEFT) -->
        <ScrollView
            android:id="@+id/dockLeft"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@color/bg_surface"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone" />

        <View
            android:id="@+id/dividerDockLeft"
            android:layout_width="1.5dp"
            android:layout_height="match_parent"
            android:background="@color/border_hairline"
            android:visibility="gone" />

        <!-- 中央工作区：主工具行 + 画笔属性行 + 画布 + 底部胶片抽屉 -->
        <LinearLayout
            android:id="@+id/layoutCenter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 顶部主工具栏 (Dock TOP - 第 1 行：全部 15 个核心工具一屏完整呈现，零盲滑截断) -->
            <HorizontalScrollView
                android:id="@+id/dockTop"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/bg_surface"
                android:overScrollMode="never"
                android:scrollbars="none">

                <!-- 工具栏内容整体 (可停靠于顶部或左右侧) -->
                <LinearLayout
                    android:id="@+id/layoutToolBarContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp">

                    <ImageButton
                        android:id="@+id/btnToolPen"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_pen"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="笔（再点一次打开设置）"
                        android:layout_marginEnd="4dp" />

                    <ImageButton
                        android:id="@+id/btnToolHighlighter"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_highlighter"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="荧光笔"
                        android:layout_marginEnd="4dp" />

                    <ImageButton
                        android:id="@+id/btnToolEraser"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_eraser"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="橡皮擦"
                        android:layout_marginEnd="4dp" />

                    <ImageButton
                        android:id="@+id/btnToolLasso"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_lasso"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="套索选择"
                        android:layout_marginEnd="4dp" />

                    <ImageButton
                        android:id="@+id/btnToolShape"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_shape"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="形状（支持直线、箭头、矩形、圆、多边形）"
                        android:layout_marginEnd="4dp" />

                    <ImageButton
                        android:id="@+id/btnToolText"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_text"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="文字框"
                        android:layout_marginEnd="4dp" />

                    <ImageButton
                        android:id="@+id/btnToolTape"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_tape"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="记忆遮挡胶带（涂抹遮挡重点，点按揭开背诵）"
                        android:layout_marginEnd="4dp" />

                    <ImageButton
                        android:id="@+id/btnToolLaser"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_laser"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="激光教鞭（自动消隐演示轨迹）" />

                    <View
                        android:id="@+id/dividerTool1"
                        android:layout_width="1.5dp"
                        android:layout_height="22dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@color/border_hairline" />

                    <ImageButton
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:id="@+id/btnUndo"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_undo"
                        android:contentDescription="撤销"
                        android:layout_marginEnd="4dp" />

                    <ImageButton
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:id="@+id/btnRedo"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_redo"
                        android:contentDescription="重做" />

                    <View
                        android:id="@+id/dividerTool2"
                        android:layout_width="1.5dp"
                        android:layout_height="22dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@color/border_hairline" />

                    <ImageButton
                        android:id="@+id/btnRuler"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_ruler"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="直尺与量角器（支持 15° 磁吸）"
                        android:layout_marginEnd="4dp" />

                    <ImageButton
                        android:id="@+id/btnInsertImage"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_image"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="插入图片"
                        android:layout_marginEnd="4dp" />

                    <ImageButton
                        android:id="@+id/btnLayers"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_layers"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="图层"
                        android:layout_marginEnd="4dp" />

                    <ImageButton
                        android:id="@+id/btnRecord"
                        android:layout_width="35dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_secondary"
                        android:src="@drawable/ic_mic"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="音字同步录音"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnPageTemplate"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="底纹"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_button_secondary"
                        android:drawableStart="@drawable/ic_paper_template"
                        android:drawablePadding="3dp"
                        android:paddingHorizontal="8dp"
                        android:minWidth="0dp"
                        android:stateListAnimator="@null" />
                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:id="@+id/dividerToolTop"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_hairline" />

            <!-- 第 2 行：画笔预设槽位 + 汉字标识色板 + 笔尖粗细属性条（独立成行，彻底告别横向截断） -->
            <LinearLayout
                android:id="@+id/layoutPenPropertyBar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="@color/bg_surface">

                <!-- 常用画笔快捷预设托盘 (3个预设位，支持一键切换与长按保存) -->
                <LinearLayout
                    android:id="@+id/layoutPenPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:id="@+id/slotPreset1"
                        android:layout_width="36dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_button_secondary"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/tvPreset1Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:text="1" />
                        <View
                            android:id="@+id/vPreset1Color"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="2dp" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/slotPreset2"
                        android:layout_width="36dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_button_secondary"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/tvPreset2Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:text="2" />
                        <View
                            android:id="@+id/vPreset2Color"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="2dp" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/slotPreset3"
                        android:layout_width="36dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_button_secondary"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/tvPreset3Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:text="3" />
                        <View
                            android:id="@+id/vPreset3Color"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="2dp" />
                    </FrameLayout>
                </LinearLayout>

                <View
                    android:id="@+id/dividerTool3"
                    android:layout_width="1.5dp"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/border_hairline" />

                <!-- 当前工具的快捷色板（带黑/蓝/红/绿汉字标识） -->
                <LinearLayout
                    android:id="@+id/layoutQuickColors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

                <View
                    android:id="@+id/dividerTool4"
                    android:layout_width="1.5dp"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/border_hairline" />

                <TextView
                    android:id="@+id/tvToolHint"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/bg_button_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:visibility="visible" />
            </LinearLayout>

            <View
                android:id="@+id/dividerPenProperty"
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:background="@color/border_hairline" />

            <!-- 画布手写主区域 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.adnote.ui.InkCanvasView
                    android:id="@+id/inkCanvas"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- 悬浮退出全屏/禅模式按钮 -->
                <LinearLayout
                    android:id="@+id/btnExitZen"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_selection_bar"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_fullscreen_exit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="退出禅模式"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- 套索选区操作条 -->
                <HorizontalScrollView
                    android:id="@+id/layoutSelectionBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="12dp"
                    android:scrollbars="none"
                    android:background="@drawable/bg_selection_bar"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="6dp">

                        <TextView
                            android:id="@+id/tvSelectionInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:paddingHorizontal="8dp" />

                        <Button android:id="@+id/btnSelCut" style="@style/SelectionAction" android:text="剪切" />
                        <Button android:id="@+id/btnSelCopy" style="@style/SelectionAction" android:text="拷贝" />
                        <Button android:id="@+id/btnSelDuplicate" style="@style/SelectionAction" android:text="复制一份" />
                        <Button android:id="@+id/btnSelDelete" style="@style/SelectionAction" android:text="删除" />
                        <Button android:id="@+id/btnSelColor" style="@style/SelectionAction" android:text="改色" />
                        <Button android:id="@+id/btnSelToText" style="@style/SelectionAction" android:text="转文字" />
                        <Button android:id="@+id/btnSelLayer" style="@style/SelectionAction" android:text="移到图层" />
                        <Button android:id="@+id/btnSelDone" style="@style/SelectionAction" android:text="完成" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- 录音中 / 音字同步回放提示条 -->
                <LinearLayout
                    android:id="@+id/layoutRecordingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp"
                    android:background="@drawable/bg_selection_bar"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvRecordingTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● 录音中 0:00"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#DC2626"
                        android:paddingHorizontal="8dp" />

                    <Button android:id="@+id/btnStopRecording" style="@style/SelectionAction" android:text="停止" />
                </LinearLayout>

                <!-- 缩放比例，点按复位 -->
                <TextView
                    android:id="@+id/tvZoom"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_selection_bar"
                    android:visibility="gone" />

                <!-- 底部浮动识别结果面板 -->
                <LinearLayout
                    android:id="@+id/layoutRecognized"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:background="@drawable/bg_drawer_recognized"
                    android:visibility="gone"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="✨ 识别结果 (已同步至 Markdown)"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/btnCloseRecognized"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="关闭"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:padding="4dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRecognizedResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:maxLines="5"
                        android:ellipsize="end" />
                </LinearLayout>
            </FrameLayout>

            <!-- 底部实时页码胶片快速导航栏 (Filmstrip Drawer) -->
            <LinearLayout
                android:id="@+id/layoutFilmstripBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_surface"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_hairline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📑 页面胶片导航"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginEnd="10dp" />

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layoutFilmstripItems"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" />
                    </HorizontalScrollView>

                    <Button
                        android:id="@+id/btnCloseFilmstrip"
                        style="@style/SelectionAction"
                        android:text="收起" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Obsidian 同屏双开对照侧边栏 (Split View) -->
        <LinearLayout
            android:id="@+id/layoutSplitObsidian"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_surface_subtle"
            android:visibility="gone">

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/border_hairline"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="@color/bg_surface">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔗 Obsidian 实时双栏对照"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnSaveSplitObsidian"
                    style="@style/SelectionAction"
                    android:text="保存" />

                <Button
                    android:id="@+id/btnCloseSplitObsidian"
                    style="@style/SelectionAction"
                    android:text="关闭" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_hairline" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="用户自由编辑区（双向合并保护，永不覆盖）"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etSplitObsidianMd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="6"
                        android:gravity="top|start"
                        android:background="@drawable/bg_edit_text"
                        android:padding="10dp"
                        android:hint="在此输入 Markdown 笔记、大纲或 [[双链]]，将与手写 SVG 一起同步至 Obsidian…"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本页手写 OCR 实时索引预览"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvSplitOcrPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_note"
                        android:padding="10dp"
                        android:text="（暂无识别文本，点击顶栏「识别」或翻页自动提取）"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <View
            android:id="@+id/dividerDockRight"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/border_hairline"
            android:visibility="gone" />

        <!-- 右侧垂直避手停靠栏 (Dock RIGHT) -->
        <ScrollView
            android:id="@+id/dockRight"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@color/bg_surface"
            android:scrollbars="none"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
