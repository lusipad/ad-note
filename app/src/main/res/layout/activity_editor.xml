<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- 顶部现代化工具栏 -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/bg_surface">

        <!-- 返回按钮 -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_arrow_back"
            android:padding="8dp"
            android:stateListAnimator="@null" />

        <!-- 笔记标题 -->
        <TextView
            android:id="@+id/tvNoteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:text="未命名笔记"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 翻页胶囊组件 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_button_secondary"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="6dp">

            <Button
                android:id="@+id/btnPrevPage"
                android:layout_width="30dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:drawableStart="@drawable/ic_chevron_left"
                android:padding="5dp"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/tvPageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 / 1"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="6dp" />

            <Button
                android:id="@+id/btnNextPage"
                android:layout_width="30dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:drawableStart="@drawable/ic_chevron_right"
                android:padding="5dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- 添加页按钮 -->
        <Button
            android:id="@+id/btnAddPage"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+页"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_button_secondary"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@null"
            android:layout_marginEnd="6dp" />

        <!-- 纸张底质模板按钮 -->
        <Button
            android:id="@+id/btnPageTemplate"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_paper_template"
            android:padding="8dp"
            android:stateListAnimator="@null"
            android:layout_marginEnd="6dp" />

        <!-- 画笔配置按钮（颜色与粗细） -->
        <Button
            android:id="@+id/btnPenSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_pen"
            android:padding="8dp"
            android:stateListAnimator="@null"
            android:layout_marginEnd="6dp" />

        <!-- 撤销按钮 -->
        <Button
            android:id="@+id/btnUndo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_undo"
            android:padding="8dp"
            android:stateListAnimator="@null"
            android:layout_marginEnd="6dp" />

        <!-- 识别按钮 -->
        <Button
            android:id="@+id/btnRecognize"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="识别"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_recognize"
            android:drawablePadding="2dp"
            android:paddingHorizontal="8dp"
            android:stateListAnimator="@null"
            android:layout_marginEnd="6dp" />

        <!-- 全刷按钮 -->
        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_refresh_full"
            android:padding="8dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!-- 极细分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_hairline" />

    <!-- 画布手写主区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.adnote.ui.InkCanvasView
            android:id="@+id/inkCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 底部浮动识别结果面板 -->
        <LinearLayout
            android:id="@+id/layoutRecognized"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/bg_drawer_recognized"
            android:visibility="gone"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✨ 识别结果 (已同步至 Markdown)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/btnCloseRecognized"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关闭"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:padding="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRecognizedResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:maxLines="5"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
