<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_note"
    android:padding="10dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvOutlinePageNum"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:text="第 1 页"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/tvOutlineBookmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔖 书签标题"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvOutlineSnippet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="文字预览..."
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOutlineCurrentBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前页"
        android:textSize="10sp"
        android:textColor="@color/badge_pdf_text"
        android:background="@drawable/bg_badge_pdf"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:layout_marginEnd="6dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnOutlineEditBookmark"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:text="书签"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/bg_chip_unselected"
        android:paddingHorizontal="8dp"
        android:stateListAnimator="@null" />
</LinearLayout>
