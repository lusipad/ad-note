<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <!-- 顶栏标题与返回 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_arrow_back"
            android:padding="8dp"
            android:stateListAnimator="@null"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- 卡片 1：WebDAV 云端同步 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_settings"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_webdav_header"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="配置坚果云、NAS 等 WebDAV，自动双向同步为 Obsidian 兼容库"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_server_url"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_edit_text"
                android:hint="@string/settings_server_url_hint"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:singleLine="true"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_username"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_edit_text"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:singleLine="true"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_password"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_edit_text"
                android:inputType="textPassword"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_remote_dir"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary" />

            <EditText
                android:id="@+id/etRemoteDir"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_edit_text"
                android:text="AdNote"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:singleLine="true"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTestConnection"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="@string/settings_test_connection"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_button_secondary"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="@string/settings_save"
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_button_primary"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- 卡片 2：设备与画笔适配 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_settings"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_device_header"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="智能识别墨水屏与高刷平板，调度最佳低延迟通道"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvDeviceInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="设备检测：检测中..."
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvPenStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="画笔通道：检测中..."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp" />

            <CheckBox
                android:id="@+id/cbStylusOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="防误触模式（严格仅手写笔响应，手掌压屏不误画）"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <CheckBox
                android:id="@+id/cbPreferOnyx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="优先使用文石硬件直绘低延迟通道"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnFullRefreshTest"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/settings_full_refresh_test"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_button_secondary"
                android:paddingHorizontal="14dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- 卡片 3：离线手写模型 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_settings"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_model_header"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google ML Kit 离线中文手写识别（zh-Hani-CN 模型）"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvModelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="模型状态：检测中..."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnDownloadModel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/settings_download_model"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_button_secondary"
                android:paddingHorizontal="14dp"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
</LinearLayout>
