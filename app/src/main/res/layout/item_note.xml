<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_note"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="4dp"
    android:clickable="true"
    android:focusable="true">

    <!-- 封面色条 -->
    <View
        android:id="@+id/viewCover"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone" />

    <!-- 标题与状态徽标栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 批量选择复选框 -->
        <TextView
            android:id="@+id/tvBatchCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="☐"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <!-- 标题 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="笔记标题"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- PDF 专属徽标 -->
        <TextView
            android:id="@+id/tvPdfBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PDF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/badge_pdf_text"
            android:background="@drawable/bg_badge_pdf"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <!-- 同步状态胶囊 -->
        <TextView
            android:id="@+id/tvSyncBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 待同步"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_badge_sync"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <!-- 一键星标置顶按钮 -->
        <TextView
            android:id="@+id/btnStar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="☆"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="星标置顶" />
    </LinearLayout>

    <!-- 正文识别与 Obsidian 摘要预览行 -->
    <TextView
        android:id="@+id/tvSnippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:layout_marginTop="5dp"
        android:visibility="gone" />

    <!-- 元数据行：文件夹、页数与最后更新时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="收件箱"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:drawableStart="@drawable/ic_folder"
            android:drawablePadding="4dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvPageCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 页"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-09-27 12:00"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary" />
    </LinearLayout>

    <!-- 标签展示行 -->
    <TextView
        android:id="@+id/tvTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="#工作 #周会"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="6dp"
        android:visibility="gone" />
</LinearLayout>
