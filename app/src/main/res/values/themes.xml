<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AdNote" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorPrimary">@color/brand_black</item>
        <item name="colorPrimaryDark">@color/bg_surface</item>
        <item name="colorAccent">@color/brand_black</item>

        <!-- 墨水屏沉浸式纯白状态栏与导航栏（消除顶部黑条） -->
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>

        <!-- 禁用一切水波纹、阴影与窗口切换动画，墨水屏刷新干脆零残影 -->
        <item name="android:windowAnimationStyle">@style/NoAnimation</item>
        <item name="alertDialogTheme">@style/Theme.AdNote.Dialog</item>
        <item name="android:popupMenuStyle">@style/Theme.AdNote.PopupMenu</item>
        <item name="popupMenuStyle">@style/Theme.AdNote.PopupMenu</item>
        <item name="android:dropDownListViewStyle">@style/Theme.AdNote.DropDownList</item>
    </style>

    <!-- 墨水屏专属无遮罩、无阴影、2dp 纯黑实线边框弹窗 -->
    <style name="Theme.AdNote.Dialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/brand_black</item>
        <item name="colorPrimary">@color/brand_black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowBackground">@drawable/bg_dialog_eink</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.AdNote.PopupMenu" parent="Widget.AppCompat.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_dialog_eink</item>
        <item name="android:popupElevation">0dp</item>
        <item name="android:popupAnimationStyle">@null</item>
    </style>

    <style name="Theme.AdNote.DropDownList" parent="Widget.AppCompat.Light.ListView.DropDown">
        <item name="android:divider">@color/border_hairline</item>
        <item name="android:dividerHeight">1dp</item>
        <item name="android:overScrollMode">never</item>
    </style>

    <style name="SelectionAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="NoAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
    </style>
</resources>
