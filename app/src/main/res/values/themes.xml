<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AdNote" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorPrimary">@color/brand_black</item>
        <item name="colorPrimaryDark">@color/brand_black</item>
        <item name="colorAccent">@color/brand_black</item>

        <!-- 禁用窗口切换动画，墨水屏刷新更干脆无拖影 -->
        <item name="android:windowAnimationStyle">@style/NoAnimation</item>
        <item name="alertDialogTheme">@style/Theme.AdNote.Dialog</item>
    </style>

    <style name="Theme.AdNote.Dialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/brand_black</item>
        <item name="colorPrimary">@color/brand_black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="SelectionAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="NoAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
    </style>
</resources>
